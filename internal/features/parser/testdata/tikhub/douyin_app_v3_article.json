bjective_id\":1005}","en_name":"fake"}],"icon":"https://p3.douyinpic.com/aweme-server-static-resource/dislike_subjective.png~tplv-obj.image","text":"反馈内容问题"}],"category_da":47,"personal_page_botton_diagnose_style":2,"chapter_list":null,"origin_duet_resource_uri":"","social_tag_list":null,"image_infos":null,"share_url":"https://www.iesdouyin.com/share/video/7698925399581804456/?region=US&mid=7691901007128168474&u_code=-1&did=MS4wLjABAAAApxcqW1A9kh9hilo1RiMds--tmK0OAeZ3SKVGp1iXoY_pax_UfsPzlaKRMG5uFl7n&iid=MS4wLjABAAAA6rBqsPuYNqfb0cxK78kujtJ--3wYQNdywMXKHCziLWSyMYaWm8nmo3z8jyX6gH1k&with_sec_did=1&video_share_track_ver=&titleType=title&share_sign=wJfLGL9UGnzC3JPhgP3FozpbTem0CqCsBdhWun4RV9c-&share_version=380000&ts=1792548101&from_aid=1128&from_ssr=1&share_track_info=%7B%22link_description_type%22%3A%22%22%7D","is_aigc_media":false,"shoot_way":"direct_shoot","collection_corner_mark":0,"geofencing_regions":null,"article_info":{"container_lynx_url":"aweme://lynxview/?channel=morphling_high&bundle=douyin_article_detail%2Ffeed_v2%2Ftemplate.js&surl=https%3A%2F%2Flf-dy-gr-sourcecdn.bytegecko.com%2Fobj%2Fbyte-gurd-source-gr%2Fsearch%2Ffe%2Fdouyin%2Fmorphling_high%2Fdouyin_article_detail%2Ffeed_v2%2Ftemplate.js&dynamic=1&group=morphling_high&fe_enable_preserve_data=1&thread_strategy=2&ab_params=long_article_feed_config,long_article_feed_immersive_color,long_article_scroll_no_list,article_detail_component_enable&enable_canvas=1&enable_canvas_optimize=1&enable_dynamic_v8=1","read_time":1,"article_title":"刚，Claude首次设计出抗蝎毒蛋白！狂算64小时，已过实测","detail_lynx_url":"aweme://lynxview/?channel=morphling_high&bundle=douyin_article_detail%2Findex%2Ftemplate.js&surl=https%3A%2F%2Flf-dy-gr-sourcecdn.bytegecko.com%2Fobj%2Fbyte-gurd-source-gr%2Fsearch%2Ffe%2Fdouyin%2Fmorphling_high%2Fdouyin_article_detail%2Findex%2Ftemplate.js&dynamic=1&group=morphling_high&fe_enable_preserve_data=1&ab_params=long_article_feed_config,AWEUGCEnableHashTagPrefix,enable_query_prefix&enable_font_scale=1","business_id":"article","article_content":"{\"long_article_abstract\":\"刚刚，Claude首次设计出抗蝎毒蛋白！狂算64小时，已过实测\\nClaude最新成果，在生物和AI圈彻底刷屏了。今天，Anthropic公开一份研究中，内部研究版Claude设计的蛋白，真的在试管里抓住了蝎毒！64小时，318,484个蛋白设计。211个送进实验室，17个闯过结合测试。\\n翻开技术报告，作者名单排在第一位的，赫然是Claude Science。它负责设计蛋白，还在人类监督下分析数据、绘图、起草报告。\\n而且，全部211个送测方案，连同实验数据，已经公开。令人震惊的是，完成这项「神迹」的竟是一群搞金融的「门外汉」——Citrini Research。五个分析师，其中三位完全没有科学背景，带着Claude，攻入了AI药物发现的腹地。同一天，OpenAI也杀向了生物医药，反手就买下Orchestra Bio，要帮人类科学家管理药物开发。\\n这两家，从数学一路死磕到物理，如今战场又换到了生命科学。\",\"markdown\":\"刚刚，Claude首次设计出抗蝎毒蛋白！狂算64小时，已过实测\\n\\nClaude最新成果，在生物和AI圈彻底刷屏了。今天，Anthropic公开一份研究中，内部研究版Claude设计的蛋白，真的在试管里抓住了蝎毒！64小时，318,484个蛋白设计。211个送进实验室，17个闯过结合测试。\\n\\n![](https://p11-sign.douyinpic.com/tos-cn-i-0813c000-ce/oAJL1LfDIQGIAfYiEweeAA1A2A2VrGcATAm7Ky~tplv-dy-long-article:0:0.heic?lk3s=138a59ce\\u0026x-expires=1793757600\\u0026x-signature=loP3QXHujdIFlPVq27r2qDWYgY8%3D\\u0026from=327834062 width=1080 height=760)\\n\\n翻开技术报告，作者名单排在第一位的，赫然是Claude Science。它负责设计蛋白，还在人类监督下分析数据、绘图、起草报告。\\n\\n![](https://p26-sign.douyinpic.com/tos-cn-i-0813c000-ce/o4fqgR9DADD2AYEEoEFPaEA9EhA7IwClBaAnfA~tplv-dy-long-article:0:0.heic?lk3s=138a59ce\\u0026x-expires=1793757600\\u0026x-signature=h1bi3bbNIeNrL%2FyV1wV4sJ3i5yg%3D\\u0026from=327834062 width=1080 height=350)\\n\\n而且，全部211个送测方案，连同实验数据，已经公开。令人震惊的是，完成这项「神迹」的竟是一群搞金融的「门外汉」——Citrini Research。五个分析师，其中三位完全没有科学背景，带着Claude，攻入了AI药物发现的腹地。同一天，OpenAI也杀向了生物医药，反手就买下Orchestra Bio，要帮人类科学家管理药物开发。\\n\\n![](https://p3-sign.douyinpic.com/tos-cn-i-0813c000-ce/oI9AE2anCIABaAK7RVEPYfAoiwElfCDDqEA9AF~tplv-dy-long-article:0:0.heic?lk3s=138a59ce\\u0026x-expires=1793757600\\u0026x-signature=OqKarNhNpGvxy8DDFrl0ZLmTIfY%3D\\u0026from=327834062 width=1080 height=650)\\n\\n这两家，从数学一路死磕到物理，如今战场又换到了生命科学。\\n\\n\\u003cbr/\\u003e\\n\\n\\u003cbr/\\u003e\"}","article_id":"7698925399581804456","search_article_lynx_url":"aweme://lynxview/?channel=morphling_high&bundle=douyin_article_detail%2Fembedded_article%2Ftemplate.js&surl=https%3A%2F%2Flf-dy-gr-sourcecdn.bytegecko.com%2Fobj%2Fbyte-gurd-source-gr