是那种‘感觉’，人之所以能获得幸福，关键大概就在这里。”我们来到叶山拜访上田义彦的家，记录了一家人平凡而温暖的一天。#隐居[话题]# #上田义彦[话题]# #老宅改造[话题]# #生活方式[话题]# #人物[话题]#","countdown":0,"ats":[],"enable_brand_lottery":false,"use_water_color":false,"in_censor":false,"need_product_review":false,"enable_co_produce":false,"red_envelope_note":false,"shared_count":2848,"images_list":[{"index":0,"fileid":"spectrum/1040g0k031ruoe8lti0005nnsdpj08rd1d0o3kd8","scale_to_large":4,"url_multi_level":{"low":"https://sns-i11.rednotecdn.com/spectrum/1040g0k031ruoe8lti0005nnsdpj08rd1d0o3kd8?imageView2/2/w/576/format/webp/q/75%7CimageMogr2/strip&redImage/frame/0&ap=1&sc=V_PRV&sign=2fd6067e196b4bbafb959c3c70c28a19&t=6ad1b55c","high":"https://sns-i11.rednotecdn.com/spectrum/1040g0k031ruoe8lti0005nnsdpj08rd1d0o3kd8?imageView2/2/w/576/format/webp/q/75%7CimageMogr2/strip&redImage/frame/0&ap=1&sc=V_PRV&sign=2fd6067e196b4bbafb959c3c70c28a19&t=6ad1b55c","medium":"https://sns-i11.rednotecdn.com/spectrum/1040g0k031ruoe8lti0005nnsdpj08rd1d0o3kd8?imageView2/2/w/576/format/webp/q/75%7CimageMogr2/strip&redImage/frame/0&ap=1&sc=V_PRV&sign=2fd6067e196b4bbafb959c3c70c28a19&t=6ad1b55c"},"original":"https://sns-i11.rednotecdn.com/spectrum/1040g0k031ruoe8lti0005nnsdpj08rd1d0o3kd8?imageView2/2/w/5000/h/5000/format/webp/q/90&ap=1&sc=V_ORG&sign=2fd6067e196b4bbafb959c3c70c28a19&t=6ad1b55c","longitude":0,"latitude":0,"width":1516,"url":"https://sns-i11.rednotecdn.com/spectrum/1040g0k031ruoe8lti0005nnsdpj08rd1d0o3kd8?imageView2/2/w/576/format/webp/q/87%7CimageMogr2/strip&redImage/frame/0&ap=1&sc=V_PRV&sign=2fd6067e196b4bbafb959c3c70c28a19&t=6ad1b55c","need_load_original_image":true,"origin_img":{"width":1516,"size":0,"height":2022},"height":2022,"trace_id":"spectrum/1040g0k031ruoe8lti0005nnsdpj08rd1d0o3kd8","text_intention":0}],"may_have_red_packet":false,"has_music":false,"enable_fls_bridge_cards":false,"model_type":"note","seeded":false,"view_count":0,"time":1769737966,"has_co_produce":false,"collected_count":4265,"privacy":{"type":0,"show_tips":false,"nick_names":""},"