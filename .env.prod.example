# =============================================================================
# Squyrrl API · 生产运行时环境变量模板
#
# 用法（在服务器的本目录下）：
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#   逐行把标了 CHANGE_ME 的值替换掉。
#
# 作用域：只有 api 容器读这份文件。tgbot / admin 各持自己的 .env.prod，拿不到
# 下面的数据库连接串和支付密钥 —— 这是拆分部署换来的最小权限（2026-09-03）。
#
# 与本文件并存的 .env.example 是「原生跑 go run 的本机开发模板」，两者用途不同、
# 不要互相复制。容器化开发用同目录 docker-compose.dev.yml，它会就地覆盖 .env 里的宿主地址。
# 完整变量字典见父仓库 squyrrl 的 docs/readme/08-env-vars.md。
#
# 写法约定 —— 空值变量的注释必须另起一行，不能写成 `KEY=  # 说明`：
# compose 解析 env_file 时只对「非空值」剥离行内注释，值为空时整段 `# 说明` 会被
# 当成值注入容器。此坑对支付类变量尤其致命：SQUYRRL_STRIPE_WEBHOOK_SECRET 拿到
# 字符串 "# whsec_..." 后会被判定为「已配置」，于是拿错误密钥验签，所有 Stripe
# 回调静默失败 —— 比留空（不启用校验）更难排查。
# =============================================================================

# ---- 数据库连接串（pgx）----
# 外部托管云 Postgres，从云控制台复制；生产务必带 sslmode=require。
SQUYRRL_DATABASE_URL=postgres://USER:PASS@db-host.provider.com:5432/squyrrl?sslmode=require

# ---- 对象存储（Cloudflare R2）----
SQUYRRL_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
SQUYRRL_S3_ACCESS_KEY=CHANGE_ME      # R2 → Manage R2 API Tokens 生成的 Access Key ID
SQUYRRL_S3_SECRET_KEY=CHANGE_ME      # 同上生成的 Secret Access Key
SQUYRRL_S3_USE_SSL=true              # R2 必须走 https
# SQUYRRL_S3_BUCKET 默认 squyrrl（config.go 内置），需要时才加此行覆盖

# ---- 邮件发送（Resend HTTP API）----
SQUYRRL_RESEND_API_KEY=CHANGE_ME     # re_xxx；留空则 OTP 只打日志、用户收不到验证码
# 发信域为组织级 lumixord.com（Resend 免费版仅支持一个已验证域），SPF/DKIM/DMARC 配在该域
SQUYRRL_MAIL_FROM=Squyrrl <noreply@lumixord.com>   # 须为 Resend 已验证的发信域

# ---- 内部 server-to-server token（api 侧为校验方；禁止下发给任何浏览器 / 客户端）----
# 生成：openssl rand -base64 32。两串各守一段、按最小权限分权（见 server.go）：
#   · TG_INTERNAL_TOKEN → 守 /internal/tg（Bot 绑定 / 转发碎片）
#   · INTERNAL_TOKEN    → 守 /internal/admin（发币、改第三方 endpoint 密钥等高危）
# 两者取值必须不同：即便 Bot 凭证泄漏也碰不到管理端。留空 = 对应端点组整体 401（fail-closed）。
#
# 拆分部署后这两串是「跨服务共享值」：改这里必须同步改
#   · squyrrl-server-thirdpart-telegram 仓库 .env.prod 的 SQUYRRL_TG_INTERNAL_TOKEN
#   · squyrrl-server-web-admin          仓库 .env.prod 的 SQUYRRL_INTERNAL_TOKEN
# 不一致的表现是对应服务全线 401，而非启动失败 —— 轮换时记得两边一起改、一起重启。
SQUYRRL_TG_INTERNAL_TOKEN=CHANGE_ME  # openssl rand -base64 32（Bot ↔ API）
SQUYRRL_INTERNAL_TOKEN=CHANGE_ME     # 另生成一串，勿复用 TG 值（admin → API）

# ---- Telegram Bot 用户名（不是密钥，可公开）----
# 用于拼绑定 deep link：t.me/<username>?start=<token>。API 负责拼装，客户端只渲染
# 二维码 —— 换 Bot 只改这一行，不用发三端版本。填 BotFather 里那个不带 @ 的名字。
# 留空 ⇒ POST /me/tg/binding/link 返回 503「功能暂未开放」，其余 TG 端点照常。
SQUYRRL_TG_BOT_USERNAME=CHANGE_ME

# ---- WebAuthn / Passkey（无密码登录的信赖方 Relying Party 配置）----
# RP_ID = 无协议无端口的注册域名，passkey 绑定到它、事后不可改；填顶级域即可覆盖各子域。
# ORIGINS = 允许发起认证的完整来源白名单（逗号分隔、含协议），须列全所有会调 passkey 的前端。
SQUYRRL_WEBAUTHN_RP_ID=squyrrl.com
SQUYRRL_WEBAUTHN_RP_NAME=Squyrrl
SQUYRRL_WEBAUTHN_ORIGINS=https://squyrrl.com,https://pwa.squyrrl.com,https://admin.squyrrl.com

# ---- 第三方付费解析 endpoint 的密钥（约定式，按需加，可有多个）----
# config.go 不预先声明这类变量：api_endpoints 表的 config 用 env 占位符按名引用，
# 运行时读环境变量注入、密钥永不落库。变量名自定，与该 endpoint config 引用的名字对上即可。
# 示例：RapidAPI 密钥，按需填
SQUYRRL_RAPIDAPI_KEY=

# ---- 订阅 / 支付回调签名密钥（留空 = 对应 provider 不启用其 webhook 校验）----
# whsec_...（Stripe Dashboard → Developers → Webhooks）
SQUYRRL_STRIPE_WEBHOOK_SECRET=
# App Store Connect → App 内购项目 → App-Specific 共享密钥
SQUYRRL_APPLE_SHARED_SECRET=
# https://api.squyrrl.com/webhooks/google（RTDN OIDC 期望的 aud）
SQUYRRL_GOOGLE_PUBSUB_AUD=

# ---- 对外发布端口（映射到 127.0.0.1:<端口>，须与同目录 nginx.conf 的 proxy_pass 对齐）----
SQUYRRL_API_PORT=10260
