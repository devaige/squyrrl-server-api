# 开发环境配置示例。复制为 .env 后按需修改。
# main.go 通过 godotenv autoload 在启动时自动读取同目录下的 .env。

SQUYRRL_ENV=dev
# 原生 go run 时直接占用宿主端口；容器化跑由 compose 覆盖回 :8080（见 dev/prod compose 注释）。
SQUYRRL_HTTP_ADDR=:10260

SQUYRRL_DATABASE_URL=postgres://squyrrl:squyrrl_dev@localhost:55432/squyrrl?sslmode=disable

SQUYRRL_S3_ENDPOINT=http://localhost:59000
# SQUYRRL_S3_BUCKET 默认 squyrrl（config.go 内置），需要时才取消注释覆盖
SQUYRRL_S3_ACCESS_KEY=squyrrl
SQUYRRL_S3_SECRET_KEY=squyrrl_dev_secret
SQUYRRL_S3_USE_SSL=false

# 邮件（Resend HTTP API）；留空 = 本地日志模式：OTP 不外发，直接打进 API 日志。
# 生产填 re_xxx，且 SQUYRRL_MAIL_FROM 须为 Resend 已验证发信域。
SQUYRRL_RESEND_API_KEY=
SQUYRRL_MAIL_FROM=Squyrrl <noreply@squyrrl.com>

# 内部 token（dev 用占位值；生产各自用 32+ 字节随机串、勿复用）。分权见 server.go：
#   TG_INTERNAL_TOKEN 守 /internal/tg（Bot）；INTERNAL_TOKEN 守 /internal/admin（管理后台）
SQUYRRL_TG_INTERNAL_TOKEN=dev-tg-internal-secret
SQUYRRL_INTERNAL_TOKEN=dev-admin-internal-secret

# Bot 的 @username（不带 @），用于拼绑定 deep link t.me/<name>?start=<token>。
# 留空 ⇒ POST /me/tg/binding/link 返回 503（其余 TG 端点不受影响）。
SQUYRRL_TG_BOT_USERNAME=

# WebAuthn / Passkey（dev 配置；生产改成真实 squyrrl.com 域名）
SQUYRRL_WEBAUTHN_RP_ID=localhost
SQUYRRL_WEBAUTHN_RP_NAME=Squyrrl
SQUYRRL_WEBAUTHN_ORIGINS=http://localhost:10260,http://localhost:3000

# SQUYRRL_PARSE_COST 默认 2（config.go 内置，每次解析都扣、命中也扣）；本地想免费解析就取消下一行注释
# SQUYRRL_PARSE_COST=0
