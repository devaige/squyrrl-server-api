# 开发环境配置示例。复制为 .env 后按需修改。
# main.go 通过 godotenv autoload 在启动时自动读取同目录下的 .env。

SQUYRRL_ENV=dev
SQUYRRL_HTTP_ADDR=:8080

SQUYRRL_DATABASE_URL=postgres://squyrrl:squyrrl_dev@localhost:55432/squyrrl?sslmode=disable

SQUYRRL_REDIS_URL=redis://localhost:56379/0
SQUYRRL_NATS_URL=nats://localhost:54222

SQUYRRL_S3_ENDPOINT=http://localhost:59000
SQUYRRL_S3_BUCKET=squyrrl-dev
SQUYRRL_S3_ACCESS_KEY=squyrrl
SQUYRRL_S3_SECRET_KEY=squyrrl_dev_secret
SQUYRRL_S3_USE_SSL=false

# Mailhog（dev）；生产替换为真实 SMTP
SQUYRRL_SMTP_HOST=localhost
SQUYRRL_SMTP_PORT=51025
SQUYRRL_SMTP_USER=
SQUYRRL_SMTP_PASS=
SQUYRRL_SMTP_FROM=Squyrrl <noreply@squyrrl.app>

# TG Bot ↔ API 内部 token（dev 用占位值；生产请用 32+ 字节随机字符串）
SQUYRRL_TG_INTERNAL_TOKEN=dev-tg-internal-secret

# WebAuthn / Passkey（dev 配置；生产改成真实 squyrrl.app 域名）
SQUYRRL_WEBAUTHN_RP_ID=localhost
SQUYRRL_WEBAUTHN_RP_NAME=Squyrrl
SQUYRRL_WEBAUTHN_ORIGINS=http://localhost:8080,http://localhost:3000

# URI 解析每次 cache-miss 扣减的 credits；0 = 不强制（dev 默认 0，prod 推荐 2）
SQUYRRL_PARSE_COST=0
